  hint: {fileID: 364717832}
  commonGoal: 'Ortak hedef: sure dolmadan balyalardan yol kurup kuluckaya ulasmak.'
  hintText: 'Tab (basili tut): rolunu tekrar gor'
  showSeconds: 6
  fadeSpeed: 4
  infos:
  - role: 0
    task: 'Gizli gorevin: Sure dolmadan kuluckaya ulas ve sabotajciyi bul. Balyalari
      duzgun yerlestir.'
    color: {r: 0.45, g: 0.85, b: 0.5, a: 1}
  - role: 1
    task: 'Gizli gorevin: Safe gibi davran ama kuluckaya ILK ulasan sen ol. Ilk ulasirsan
      kazanirsin.'
    color: {r: 1, g: 0.65, b: 0.25, a: 1}
  - role: 2
    task: 'Gizli gorevin: Masum gorun ama oylamayla elenmek iste. Elenirsen kesin
      kazanirsin.'
    color: {r: 0.75, g: 0.5, b: 1, a: 1}
  - role: 3
    task: 'Gizli gorevin: Balyalari hafif yamuk koy, golden su alip balyalara dok,
      gizli item kullan. Sure bitene kadar kimsenin cikmasini engelle.'
    color: {r: 1, g: 0.35, b: 0.35, a: 1}
